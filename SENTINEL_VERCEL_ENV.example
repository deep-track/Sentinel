# Sentinel — Vercel Production Environment (template)
# Add these in Vercel Project Settings → Environment Variables → Production.
# Do not commit a file containing real values: every <...> below is a
# placeholder to be replaced in the Vercel dashboard only.

NODE_ENV=production
APP_BASE_URL=https://<your-sentinel-domain>
NEXT_PUBLIC_APP_URL=https://<your-sentinel-domain>

# Auth0 runtime authentication
AUTH0_SECRET=<generate-a-long-random-secret-at-least-32-bytes>
AUTH0_DOMAIN=<your-tenant>.<region>.auth0.com
AUTH0_CLIENT_ID=<Sentinel-Auth0-regular-web-app-client-ID>
AUTH0_CLIENT_SECRET=<Sentinel-Auth0-client-secret>
AUTH0_ROLE_CLAIM=https://deeptrack.io/roles
AUTH0_COMPANY_ID_CLAIM=https://deeptrack.io/companyId

# Auth0 Organizations — required. Login always uses this organization and
# sessions issued for a different org_id are rejected.
AUTH0_ORGANIZATION_ID=<org_xxxxxxxxxxxxxxxx>

# Required only if the Sentinel back office sends Auth0 organization invitations
AUTH0_MANAGEMENT_CLIENT_ID=<Auth0-machine-to-machine-management-client-ID>
AUTH0_MANAGEMENT_CLIENT_SECRET=<Auth0-machine-to-machine-management-client-secret>
AUTH0_INVITATION_CLIENT_ID=<Auth0-application-client-ID-used-for-invitations>
AUTH0_INVITATION_CONNECTION_ID=<Auth0-database-connection-ID-used-for-invitations>

# Convex production
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment-name>.convex.cloud
CONVEX_DEPLOYMENT=<your-deployment-name>
CONVEX_SITE_URL=https://<your-deployment-name>.convex.site

# Optional server-side integrations — configure only if enabled by the application
DEEPTRACK_BACKEND_URL=<approved-private-Deeptrack-backend-URL>
OPENSANCTIONS_API_KEY=<OpenSanctions-key-if-enabled>
UPLOADTHING_TOKEN=<UploadThing-token-if-the-upload-module-is-enabled>
RESEND_API_KEY=<Resend-key-if-email-invitations-are-enabled>

# Do not add Auth0 secrets, Convex secrets, database credentials, or API keys
# as NEXT_PUBLIC_* variables.

# ---------------------------------------------------------------------------
# NOT Vercel variables. The fail-closed internal administrator bootstrap is
# read only by Convex functions (backend/convex/lib/rbac.ts). Set these in the
# Convex dashboard → Deployment Settings → Environment Variables (or with
# `npx convex env set`). Setting them in Vercel has no effect.
#
#   SENTINEL_INTERNAL_ADMIN_EMAILS=<comma-separated-verified-admin-emails>
#   SENTINEL_INTERNAL_ADMIN_SUBJECTS=<comma-separated-Auth0-subject-IDs>
#
# Keep SENTINEL_INTERNAL_ADMIN_SUBJECTS empty unless the approved Auth0
# subject IDs are explicitly known. Prefer Auth0 role claims over both.
# ---------------------------------------------------------------------------
