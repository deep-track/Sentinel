# Sentinel production environment template
# Store real values in the deployment secret manager. Never commit .env files.

NODE_ENV=production
APP_BASE_URL=https://sentinel.example.com
NEXT_PUBLIC_APP_URL=https://sentinel.example.com

# Auth0 runtime authentication
AUTH0_SECRET=
AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ROLE_CLAIM=https://deeptrack.io/role
AUTH0_COMPANY_ID_CLAIM=https://deeptrack.io/companyId

# Auth0 Organizations invitation management
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_ORGANIZATION_ID=
AUTH0_INVITATION_CLIENT_ID=
AUTH0_INVITATION_CONNECTION_ID=

# Convex deployment/auth integration
# Set these according to the approved Convex deployment environment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=

# Server-side integrations
DEEPTRACK_BACKEND_URL=
OPENSANCTIONS_API_KEY=

# Optional provider values used by existing modules; configure only when enabled.
SHUFTI_CLIENT_ID=
SHUFTI_SECRET_KEY=
UPLOADTHING_TOKEN=
RESEND_API_KEY=

# Do not use public NEXT_PUBLIC_ variables for secrets.
