# Sentinel production environment template
# Store real values in the deployment secret manager. Never commit .env files.

NODE_ENV=production
APP_BASE_URL=https://sentinel.example.com
NEXT_PUBLIC_APP_URL=https://sentinel.example.com

# Auth0 runtime authentication
AUTH0_SECRET=
AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Canonical role claim is the /roles array emitted by auth0/sentinel-role-claims-action.js.
AUTH0_ROLE_CLAIM=https://deeptrack.io/roles
AUTH0_COMPANY_ID_CLAIM=https://deeptrack.io/companyId

# Auth0 Organizations. AUTH0_ORGANIZATION_ID is required for login: it is
# always sent on /auth/login and sessions issued for any other org_id are
# rejected.
AUTH0_ORGANIZATION_ID=

# Auth0 Organizations invitation management
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_INVITATION_CLIENT_ID=
AUTH0_INVITATION_CONNECTION_ID=

# Convex deployment/auth integration
# Set these according to the approved Convex deployment environment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=

# Server-side integrations
DEEPTRACK_BACKEND_URL=
# Used by the AML profile page (Next.js). AML screening runs in Convex and reads
# its own copy: set OPENSANCTIONS_API_KEY in the Convex deployment's environment
# variables too, or every AML check is held for manual review.
OPENSANCTIONS_API_KEY=

# Optional provider values used by existing modules; configure only when enabled.
SHUFTI_CLIENT_ID=
SHUFTI_SECRET_KEY=
UPLOADTHING_TOKEN=
RESEND_API_KEY=

# Convex-side variables (set in the Convex dashboard for the deployment, NOT in
# the Next.js host; the Next.js app never reads them):
#   SENTINEL_INTERNAL_ADMIN_EMAILS, SENTINEL_INTERNAL_ADMIN_SUBJECTS
#
#   Liveness invitations (the link texted to the subject):
#   LIVENESS_PUBLIC_URL                 base URL of the hosted selfie page (required)
#   AFRICASTALKING_USERNAME             SMS goes through Africa's Talking when this
#   AFRICASTALKING_API_KEY              and the API key are set ("sandbox" = sandbox)
#   AFRICASTALKING_SENDER_ID            optional approved alphanumeric sender id
#   AFRICASTALKING_CALLBACK_TOKEN       random secret; delivery report URL is
#     https://<deployment>.convex.site/webhooks/liveness/delivery/africastalking?token=<token>
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM
#                                       WhatsApp (and SMS when Africa's Talking is not set,
#                                       with TWILIO_SMS_FROM)
#   LIVENESS_DELIVERY_CALLBACK_URL      optional Twilio status callback
#   LIVENESS_CALLBACK_SECRET            HMAC secret for /webhooks/liveness/result
#
#   DeepTrack Live (fake-face check on the KYC selfie):
#   DEEPTRACK_LIVE_API_KEY              required; without it every KYC scan is held for review
#   DEEPTRACK_LIVE_BASE_URL             required; HTTPS base URL of the DeepTrack Live service (no default)

# Do not use public NEXT_PUBLIC_ variables for secrets.
